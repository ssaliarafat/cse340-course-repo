<%- include('partials/header') %>

    <main>

        <h1>
            <%= projectDetails.title %>
        </h1>

        <h2>Assign Categories</h2>

        <form action="/assign-categories/<%= projectId %>" method="POST">

            <% categories.forEach(category=> { %>

                <div>
                    <input type="checkbox" name="categoryIds" value="<%= category.category_id %>"
                        <%=assignedCategories.some(ac=> ac.category_id === category.category_id) ? "checked" : "" %>
                    >

                    <label>
                        <%= category.name %>
                    </label>

                </div>

                <% }) %>


                    <button type="submit">
                        Update Categories
                    </button>

        </form>


    </main>

    <%- include('partials/footer') %>