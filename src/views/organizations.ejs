<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p class="org-p"><b>Here are a few of our partner organizations:</b></p>
        <br>

        <ul>

            <% organizations.forEach(organization=> { %>
                <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><strong>
                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </strong>: <%= organization.contact_email %>
                </li>
                <% }); %>
        </ul>
        <p>
            <% if (user && user.role_name==="admin" ) { %>
                <a href="/new-organization">Add New Organization</a>
                <% } %>
        </p>

    </main>

    <%- include('partials/footer') %>