<%- include('partials/header') %>

    <main class="dashboard">

        <div class="dashboard-header">
            <h1>Dashboard</h1>
            <p class="dashboard-welcome">
                Welcome back, <%= name %>!
            </p>
        </div>

        <div class="profile-card">

            <h2>Your Account Information</h2>

            <div class="profile-info">
                <p>
                    <strong>Name:</strong>
                    <%= name %>
                </p>

                <p>
                    <strong>Email:</strong>
                    <%= email %>
                </p>
            </div>

        </div>

        <h2>Your Volunteer Projects</h2>
        
        <% if (volunteerProjects.length===0) { %>
        
            <p>You have not signed up for any projects yet.</p>
        
            <% } else { %>
        
                <ul>
        
                    <% volunteerProjects.forEach(project=> { %>
        
                        <li>
        
                            <strong>
                                <%= project.title %>
                            </strong>
        
                            (<%= project.location %>)
        
                                <a href="/project/<%= project.project_id %>">
                                    View
                                </a>
        
                                |
        
                                <a href="/project/<%= project.project_id %>/remove-volunteer">
                                    Remove
                                </a>
        
                        </li>
        
                        <% }) %>
        
                </ul>
        
                <% } %>

                
<% if (role==="admin" ) { %>

    <div class="admin-link-container">
        <a class="manage-users-link" href="/users">
            Manage Users
        </a>
    </div>

    <% } %>

    </main>

    <%- include('partials/footer') %>